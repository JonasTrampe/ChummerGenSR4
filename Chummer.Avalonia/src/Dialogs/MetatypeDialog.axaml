<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.NewUI.ViewModels"
        x:Class="Chummer.NewUI.Dialogs.MetatypeDialog"
        x:DataType="vm:MetatypeDialogViewModel"
        Width="520" Height="420" CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft Sans Serif, Tahoma, Segoe UI, sans-serif"
        FontSize="11"
        Background="White"
        Title="{loc:Loc Title_Metatype}">
	<Grid RowDefinitions="*,Auto" Margin="12">
		<Grid Grid.Row="0" ColumnDefinitions="180,*" ColumnSpacing="12">
			<StackPanel Grid.Column="0" Spacing="6">
				<ComboBox ItemsSource="{Binding Categories}"
				          Width="170"
				          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
				<ListBox ItemsSource="{Binding Metatypes}"
				         Height="300"
				         SelectedItem="{Binding SelectedMetatype, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>

			<Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
				<TextBlock Grid.Row="0" Text="{Binding SelectedMetatype.Name}" FontWeight="Bold" FontSize="14" />

				<Grid Grid.Row="1" ColumnDefinitions="60,*,70,*" ColumnSpacing="8">
					<TextBlock Grid.Column="0" Text="{loc:Loc String_BP}" FontWeight="Bold" />
					<TextBlock Grid.Column="1" Text="{Binding SelectedMetatype.Bp}" />
				</Grid>

				<Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="12">
					<TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc String_AttributeBODShort}" FontWeight="Bold" />
					<TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc String_AttributeAGIShort}" FontWeight="Bold" />
					<TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc String_AttributeREAShort}" FontWeight="Bold" />
					<TextBlock Grid.Row="0" Grid.Column="3" Text="{loc:Loc String_AttributeSTRShort}" FontWeight="Bold" />
					<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SelectedMetatype.BodRange}" />
					<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMetatype.AgiRange}" />
					<TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedMetatype.ReaRange}" />
					<TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedMetatype.StrRange}" />

					<TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc String_AttributeCHAShort}" FontWeight="Bold" Margin="0,6,0,0" />
					<TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Loc String_AttributeINTShort}" FontWeight="Bold" Margin="0,6,0,0" />
					<TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Loc String_AttributeLOGShort}" FontWeight="Bold" Margin="0,6,0,0" />
					<TextBlock Grid.Row="2" Grid.Column="3" Text="{loc:Loc String_AttributeWILShort}" FontWeight="Bold" Margin="0,6,0,0" />
					<TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding SelectedMetatype.ChaRange}" />
					<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedMetatype.IntRange}" />
					<TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SelectedMetatype.LogRange}" />
					<TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SelectedMetatype.WilRange}" />

					<TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc String_AttributeINIShort}" FontWeight="Bold" Margin="0,6,0,0" />
					<TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Loc String_AttributeEDGShort}" FontWeight="Bold" Margin="0,6,0,0" />
					<TextBlock Grid.Row="4" Grid.Column="2" Text="{loc:Loc String_AttributeMAGShort}" FontWeight="Bold" Margin="0,6,0,0" />
					<TextBlock Grid.Row="4" Grid.Column="3" Text="{loc:Loc String_AttributeRESShort}" FontWeight="Bold" Margin="0,6,0,0" />
					<TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding SelectedMetatype.IniRange}" />
					<TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedMetatype.EdgRange}" />
					<TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding SelectedMetatype.MagRange}" />
					<TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding SelectedMetatype.ResRange}" />
				</Grid>

				<StackPanel Grid.Row="3" Spacing="4" IsVisible="{Binding !IsCritterMode}">
					<TextBlock Text="{loc:Loc Label_Metavariant}" />
					<ComboBox Width="220"
					          HorizontalAlignment="Left"
					          ItemsSource="{Binding Metavariants}"
					          SelectedItem="{Binding SelectedMetavariant, Mode=TwoWay}" />
				</StackPanel>

				<Grid Grid.Row="4" ColumnDefinitions="90,*" ColumnSpacing="8">
					<TextBlock Grid.Column="0" Text="{loc:Loc UI_EssenceLabel}" FontWeight="Bold" />
					<TextBlock Grid.Column="1" Text="{Binding SelectedMetatype.EssRange}" />
				</Grid>

				<StackPanel Grid.Row="5" Spacing="4" VerticalAlignment="Bottom" IsVisible="{Binding !IsCritterMode}">
					<TextBlock Text="{loc:Loc UI_MagicResonanceColon}" />
					<ComboBox Width="220" HorizontalAlignment="Left" Name="MagicTypeBox" SelectedIndex="0">
						<ComboBoxItem Content="{loc:Loc UI_None}" Tag="None" />
						<ComboBoxItem Content="{loc:Loc Label_Magician}" Tag="Magician" />
						<ComboBoxItem Content="{loc:Loc Label_Adept}" Tag="Adept" />
						<ComboBoxItem Content="{loc:Loc UI_MysticAdept}" Tag="MysticAdept" />
						<ComboBoxItem Content="{loc:Loc UI_TechnomancerLabel}" Tag="Technomancer" />
					</ComboBox>
				</StackPanel>

				<StackPanel Grid.Row="5" Spacing="4" VerticalAlignment="Bottom" IsVisible="{Binding SelectedCritterUsesForce}">
					<TextBlock Text="{loc:Loc String_Force}" />
					<NumericUpDown Width="120" HorizontalAlignment="Left" Minimum="1" Maximum="50"
					                Value="{Binding Force, Mode=TwoWay}" />
				</StackPanel>
			</Grid>
		</Grid>

		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,12,0,0">
			<Button Content="{loc:Loc String_Cancel}" Width="80" Click="OnCancel" />
			<Button Content="{loc:Loc String_OK}" Width="80" Click="OnOk" />
		</StackPanel>
	</Grid>
</Window>
