<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.NewUI.ViewModels"
        xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
        x:Class="Chummer.NewUI.Dialogs.WeaponAccessoryDialog"
        x:DataType="vm:WeaponAccessoryDialogViewModel"
        Width="620" Height="500" WindowStartupLocation="CenterOwner" Title="{loc:Loc UI_SelectWeaponAccessory}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc Label_Search}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,200">
            <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:WeaponAccessoryOptionViewModel">
                        <TextBlock Text="{Binding Name}" Foreground="#1E5FA8" Margin="4,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                <TextBlock Text="{loc:Loc UI_MountColon}" FontWeight="Bold" /><TextBlock Text="{Binding Selected.Mount, TargetNullValue=–}" />
                <TextBlock Text="{loc:Loc UI_RecoilCompensationColon}" FontWeight="Bold" /><TextBlock Text="{Binding Selected.Rc, TargetNullValue=–}" />
                <TextBlock Text="{loc:Loc Label_Avail}" FontWeight="Bold" /><TextBlock Text="{Binding Selected.Availability, TargetNullValue=–}" />
                <TextBlock Text="{loc:Loc Label_Cost}" FontWeight="Bold" /><TextBlock Text="{Binding Selected.Cost, TargetNullValue=–}" />
                <TextBlock Text="{loc:Loc Label_Source}" FontWeight="Bold" Margin="0,8,0,0" /><controls:SourceLink SourcePage="{Binding Selected.SourcePage}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1" Content="{loc:Loc String_Cancel}" Width="80" Margin="0,0,6,0" Click="OnCancel" />
            <Button Grid.Column="2" Content="{loc:Loc UI_Add}" Width="90" Click="OnOk" />
        </Grid>
    </Grid>
</Window>
