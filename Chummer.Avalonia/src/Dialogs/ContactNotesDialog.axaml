<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chummer.NewUI.Dialogs.ContactNotesDialog"
        Width="420" Height="320" WindowStartupLocation="CenterOwner" Title="Notizen">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <TextBox Name="NotesTextBox" Grid.Row="0" AcceptsReturn="True" TextWrapping="Wrap"
                  VerticalContentAlignment="Top" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1" Content="Abbruch" Width="80" Margin="0,0,6,0" Click="OnCancel" />
            <Button Grid.Column="2" Content="OK" Width="80" Click="OnOk" />
        </Grid>
    </Grid>
</Window>
