<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.NewUI.ViewModels"
        xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
        x:Class="Chummer.NewUI.Dialogs.GearDialog"
        x:DataType="vm:GearDialogViewModel"
        Width="620" Height="520" WindowStartupLocation="CenterOwner" Title="Ausrüstung auswählen">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,150,Auto,*" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Kategorie:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" MaxDropDownHeight="300">
                <!-- Plain (non-virtualizing) ItemsPanel so every item is measured up front - the
                     default virtualizing panel only measures visible items, which made the popup
                     resize its width mid-scroll as wider/narrower category names got realized. -->
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="Suche:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <TextBox Grid.Column="3" Text="{Binding SearchText, Mode=TwoWay}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,200">
            <ListBox ItemsSource="{Binding GearOptions}" SelectedItem="{Binding SelectedGear, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GearOptionViewModel">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="{Binding Name}" Foreground="#1E5FA8" />
                            <TextBlock Text="{Binding CategoryDisplay}" FontSize="10" Foreground="#666666" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                <TextBlock Text="Kategorie:" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedGear.CategoryDisplay, TargetNullValue=–}" />
                <TextBlock Text="Standardstufe:" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedGear.Rating, TargetNullValue=–}" />
                <TextBlock Text="Verfügbarkeit:" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedGear.Availability, TargetNullValue=–}" />
                <TextBlock Text="Kosten:" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedGear.Cost, TargetNullValue=–}" />
                <TextBlock Text="Menge:" FontWeight="Bold" />
                <controls:IntegerSpinner Value="{Binding SelectedGear.Quantity, Mode=TwoWay}" Minimum="1" Maximum="9999"
                                          Width="90" HorizontalAlignment="Left" />
                <TextBlock Text="Kapazität:" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedGear.Capacity, TargetNullValue=–}" />
                <StackPanel Spacing="2" IsVisible="{Binding SelectedGear.IsCommlink}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Prozessor:" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedGear.Response, TargetNullValue=–}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Signal:" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedGear.Signal, TargetNullValue=–}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="System:" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedGear.SystemRating, TargetNullValue=–}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Firewall:" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedGear.Firewall, TargetNullValue=–}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Quelle:" FontWeight="Bold" Margin="0,12,0,0" />
                <TextBlock Text="{Binding SelectedGear.SourcePage, TargetNullValue=–}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1" Content="Abbruch" Width="80" Margin="0,0,6,0" Click="OnCancel" />
            <Button Grid.Column="2" Content="Weitere" Width="80" Margin="0,0,6,0" Click="OnAddAnother"
                    ToolTip.Tip="Hinzufügen, aber Dialog offen lassen" />
            <Button Grid.Column="3" Content="Hinzufügen" Width="80" Click="OnOk" />
        </Grid>
    </Grid>
</Window>
