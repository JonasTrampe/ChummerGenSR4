<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.NewUI.ViewModels"
        xmlns:controls="using:Chummer.NewUI.Controls"
        x:Class="Chummer.NewUI.Dialogs.PowerDialog"
        x:DataType="vm:PowerDialogViewModel"
        Width="560" Height="480" CanResize="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft Sans Serif, Tahoma, Segoe UI, sans-serif"
        FontSize="11" Background="White" Title="Kraft auswählen">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBlock Grid.Row="0" Text="Wähle eine noch nicht vorhandene Kraft aus den installierten Regeln aus." Margin="0,0,0,8" />
        <Grid Grid.Row="1" ColumnDefinitions="*,220">
            <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PowerOptionViewModel">
                        <TextBlock Text="{Binding Name}" Foreground="#1E5FA8" Margin="4,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                <TextBlock Text="Punkte/Stufe:" FontWeight="Bold" />
                <TextBlock Text="{Binding Selected.PointsPerLevel, TargetNullValue=–}" />
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanChooseRating}">
                    <TextBlock Text="Stufe:" FontWeight="Bold" VerticalAlignment="Center" />
                    <controls:IntegerSpinner Width="70" Minimum="1" Maximum="20" Value="{Binding Rating, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Text="Quelle:" FontWeight="Bold" Margin="0,12,0,0" />
                <TextBlock Text="{Binding Selected.SourcePage, TargetNullValue=–}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1" Content="Abbruch" Width="80" Margin="0,0,6,0" Click="OnCancel" />
            <Button Grid.Column="2" Content="Hinzufügen" Width="80" Click="OnOk" />
        </Grid>
    </Grid>
</Window>
