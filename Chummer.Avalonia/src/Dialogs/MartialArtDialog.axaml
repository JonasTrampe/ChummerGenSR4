<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.NewUI.ViewModels"
        xmlns:controls="using:Chummer.NewUI.Controls"
        x:Class="Chummer.NewUI.Dialogs.MartialArtDialog"
        x:DataType="vm:MartialArtDialogViewModel"
        Width="560" Height="480" CanResize="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft Sans Serif, Tahoma, Segoe UI, sans-serif"
        FontSize="11" Background="White" Title="{loc:Loc MessageTitle_SelectMartialArtAdvantage}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBlock Grid.Row="0" Text="{loc:Loc UI_SelectMartialArtTooltip}" Margin="0,0,0,8" />
        <Grid Grid.Row="1" ColumnDefinitions="*,220">
            <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MartialArtOptionViewModel">
                        <TextBlock Text="{Binding Name}" Foreground="#1E5FA8" Margin="4,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                <TextBlock Text="{loc:Loc UI_AdvantagesColon}" FontWeight="Bold" />
                <TextBlock Text="{Binding Selected.AdvantagesDisplay, TargetNullValue=–}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc Label_Source}" FontWeight="Bold" Margin="0,12,0,0" />
                <controls:SourceLink SourcePage="{Binding Selected.SourcePage}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1" Content="{loc:Loc String_Cancel}" Width="80" Margin="0,0,6,0" Click="OnCancel" />
            <Button Grid.Column="2" Content="{loc:Loc UI_Add}" Width="80" Click="OnOk" />
        </Grid>
    </Grid>
</Window>
