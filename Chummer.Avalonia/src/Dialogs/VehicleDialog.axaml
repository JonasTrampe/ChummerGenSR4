<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chummer.NewUI.ViewModels" x:Class="Chummer.NewUI.Dialogs.VehicleDialog" x:DataType="vm:VehicleDialogViewModel" Width="640" Height="520" WindowStartupLocation="CenterOwner" Title="Fahrzeug auswählen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <Grid ColumnDefinitions="Auto,150,Auto,*" Margin="0,0,0,8"><TextBlock Text="Kategorie:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/><TextBlock Grid.Column="2" Text="Suche:" VerticalAlignment="Center" Margin="16,0,6,0"/><TextBox Grid.Column="3" Text="{Binding SearchText, Mode=TwoWay}"/></Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,220"><ListBox ItemsSource="{Binding VehicleOptions}" SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:VehicleOptionViewModel"><StackPanel Margin="4,2"><TextBlock Text="{Binding Name}" Foreground="#1E5FA8"/><TextBlock Text="{Binding Category}" FontSize="10" Foreground="#666666"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="5"><TextBlock Text="Kategorie:" FontWeight="Bold"/><TextBlock Text="{Binding SelectedVehicle.Category, TargetNullValue=–}"/><TextBlock Text="Handling / Beschleunigung / Geschwindigkeit:" FontWeight="Bold"/><TextBlock Text="{Binding SelectedVehicle.Handling, TargetNullValue=–}"/><TextBlock Text="{Binding SelectedVehicle.Acceleration, TargetNullValue=–}"/><TextBlock Text="{Binding SelectedVehicle.Speed, TargetNullValue=–}"/><TextBlock Text="Pilot / Rumpf / Panzerung / Sensor:" FontWeight="Bold"/><TextBlock Text="{Binding SelectedVehicle.Pilot, TargetNullValue=–}"/><TextBlock Text="{Binding SelectedVehicle.Body, TargetNullValue=–}"/><TextBlock Text="{Binding SelectedVehicle.Armor, TargetNullValue=–}"/><TextBlock Text="{Binding SelectedVehicle.Sensor, TargetNullValue=–}"/><TextBlock Text="Verfügbarkeit / Kosten:" FontWeight="Bold"/><TextBlock Text="{Binding SelectedVehicle.Availability, TargetNullValue=–}"/><TextBlock Text="{Binding SelectedVehicle.Cost, TargetNullValue=–}"/><TextBlock Text="{Binding SelectedVehicle.SourcePage, TargetNullValue=–}"/></StackPanel></Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0"><Button Grid.Column="1" Content="Abbruch" Width="80" Margin="0,0,6,0" Click="OnCancel"/><Button Grid.Column="2" Content="Hinzufügen" Width="80" Click="OnOk"/></Grid>
  </Grid>
</Window>
