<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chummer.NewUI.Dialogs.ExportDialog"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft Sans Serif, Tahoma, Segoe UI, sans-serif"
        FontSize="11" Background="White" Title="Charakter exportieren">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="90,*">
        <TextBlock Grid.Row="0" Text="Exportformat:" VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TemplateBox" HorizontalAlignment="Stretch" Margin="0,0,0,6" />

        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,6" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
            <Button Content="Abbruch" Width="80" Click="OnCancel" />
            <Button Content="Exportieren..." Width="100" Click="OnExport" />
        </StackPanel>
    </Grid>
</Window>
