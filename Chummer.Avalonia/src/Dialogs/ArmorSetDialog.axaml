<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.NewUI.ViewModels"
        x:Class="Chummer.NewUI.Dialogs.ArmorSetDialog"
        x:DataType="vm:ArmorSetDialogViewModel"
        Title="{loc:Loc Button_AddBundle}" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Name des Panzerungssets:" />
        <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="z. B. Einsatzanzug" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,8,0,0">
            <Button Content="{loc:Loc String_Cancel}" Click="OnCancel" />
            <Button Content="Hinzufügen" Click="OnAdd" />
        </StackPanel>
    </StackPanel>
</Window>
