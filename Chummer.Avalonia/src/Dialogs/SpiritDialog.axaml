<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chummer.NewUI.Dialogs.SpiritDialog"
        Width="360" Height="300" CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft Sans Serif, Tahoma, Segoe UI, sans-serif"
        FontSize="11" Background="White" Title="{loc:Loc UI_AddSpiritSprite}">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnDefinitions="90,*">
        <TextBlock Grid.Row="0" Text="{loc:Loc Label_Type}" VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TypeBox" SelectedIndex="0">
            <ComboBoxItem Content="{loc:Loc UI_SpiritTypeSpirit}" />
            <ComboBoxItem Content="{loc:Loc UI_SpiritTypeSprite}" />
        </ComboBox>
        <TextBlock Grid.Row="1" Text="{loc:Loc Label_Name}" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Margin="0,8,0,0" />
        <TextBlock Grid.Row="2" Text="{loc:Loc UI_CritterTypeColon}" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CritterNameBox" Margin="0,8,0,0" />
        <TextBlock Grid.Row="3" x:Name="ForceLabel" Text="{loc:Loc Label_Power_PowerRating}" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ForceBox" Text="1" Margin="0,8,0,0" />
        <TextBlock Grid.Row="4" Text="{loc:Loc Label_Spirit_ServicesOwed}" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="ServicesBox" Text="0" Margin="0,8,0,0" />
        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
            <Button Content="{loc:Loc String_Cancel}" Width="80" Click="OnCancel" />
            <Button Content="{loc:Loc UI_Add}" Width="80" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
