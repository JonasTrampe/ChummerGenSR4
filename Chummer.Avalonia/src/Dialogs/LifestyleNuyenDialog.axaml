<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.NewUI.ViewModels"
        x:Class="Chummer.NewUI.Dialogs.LifestyleNuyenDialog"
        x:DataType="vm:LifestyleNuyenDialogViewModel"
        Width="420" Height="180" WindowStartupLocation="CenterOwner"
        Title="Startgeld auswürfeln" CanResize="False">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16" RowSpacing="10">
        <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Würfelergebnis:" VerticalAlignment="Center" />
            <NumericUpDown Minimum="{Binding MinResult}" Maximum="{Binding MaxResult}"
                            Value="{Binding DiceResult, Mode=TwoWay}" Width="120" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding FormulaPreview}" FontWeight="Bold" VerticalAlignment="Bottom" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc String_Cancel}" Width="80" Click="OnCancel" />
            <Button Content="{loc:Loc String_OK}" Width="80" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
