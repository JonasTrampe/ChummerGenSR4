<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chummer.NewUI.Dialogs.CalendarWeekDialog"
        Width="380" Height="260" CanResize="False" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft Sans Serif, Tahoma, Segoe UI, sans-serif" FontSize="11"
        Background="White">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="80,*">
        <TextBlock Grid.Row="0" Text="Jahr:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="YearBox" />
        <TextBlock Grid.Row="1" Text="Woche:" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="WeekBox" Margin="0,8,0,0" />
        <TextBlock Grid.Row="2" Text="Notizen:" VerticalAlignment="Top" Margin="0,8,0,0" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" x:Name="NotesBox" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap" />
        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
            <Button Content="Abbruch" Width="80" Click="OnCancel" />
            <Button Content="Speichern" Width="80" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
