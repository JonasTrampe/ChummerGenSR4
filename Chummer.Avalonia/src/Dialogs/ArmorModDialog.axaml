<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.NewUI.ViewModels"
        xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
        x:Class="Chummer.NewUI.Dialogs.ArmorModDialog"
        x:DataType="vm:ArmorModDialogViewModel"
        Width="680" Height="540" WindowStartupLocation="CenterOwner" Title="Panzerungs-Modifikation auswählen">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <Grid ColumnDefinitions="Auto,150,Auto,*" Margin="0,0,0,8">
            <TextBlock Text="Kategorie:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="Suche:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <TextBox Grid.Column="3" Text="{Binding SearchText, Mode=TwoWay}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,230">
            <ListBox ItemsSource="{Binding ModOptions}" SelectedItem="{Binding SelectedMod, Mode=TwoWay}">
                <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ArmorModOptionViewModel"><StackPanel Margin="4,2"><TextBlock Text="{Binding Name}" Foreground="#1E5FA8" /><TextBlock Text="{Binding Category}" FontSize="10" Foreground="#666666" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                <TextBlock Text="Kategorie:" FontWeight="Bold" /><TextBlock Text="{Binding SelectedMod.Category, TargetNullValue=–}" />
                <TextBlock Text="Ballistisch/Stoß:" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding SelectedMod.Ballistic, TargetNullValue=–}" />
                    <TextBlock Text="/" />
                    <TextBlock Text="{Binding SelectedMod.Impact, TargetNullValue=–}" />
                </StackPanel>
                <TextBlock Text="Verfügbarkeit:" FontWeight="Bold" /><TextBlock Text="{Binding SelectedMod.Availability, TargetNullValue=–}" />
                <TextBlock Text="Kosten:" FontWeight="Bold" /><TextBlock Text="{Binding SelectedMod.Cost, TargetNullValue=–}" />
                <TextBlock Text="Rating:" FontWeight="Bold" IsVisible="{Binding HasRating}" />
                <NumericUpDown Minimum="1" Maximum="{Binding SelectedMod.MaxRating}" Value="{Binding Rating, Mode=TwoWay}" IsVisible="{Binding HasRating}" />
                <TextBlock Text="Quelle:" FontWeight="Bold" Margin="0,8,0,0" /><controls:SourceLink SourcePage="{Binding SelectedMod.SourcePage}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0"><Button Grid.Column="1" Content="Abbruch" Width="80" Margin="0,0,6,0" Click="OnCancel" /><Button Grid.Column="2" Content="Hinzufügen" Width="90" Click="OnOk" /></Grid>
    </Grid>
</Window>
