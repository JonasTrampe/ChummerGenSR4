<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.NewUI.ViewModels"
        x:Class="Chummer.NewUI.Dialogs.SettingsProfileDialog"
        x:DataType="vm:SettingsProfileDialogViewModel"
        Width="400" Height="200" CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft Sans Serif, Tahoma, Segoe UI, sans-serif"
        FontSize="11"
        Background="White"
        Title="{loc:Loc Title_SelectSetting}">
	<StackPanel Margin="12" Spacing="10">
		<TextBlock Foreground="#2E6B2E" TextWrapping="Wrap"
		           Text="Wählen Sie ein Einstellungsprofil. Jedes Profil regelt die Generierungsart, Anzahl der Generierungspunkte, die maximale Verfügbarkeit und jegliche Haus-Regeln die für bei der Erschaffung eines Charakters benutzt werden." />

		<Grid ColumnDefinitions="Auto,*">
			<TextBlock Text="{loc:Loc Label_Options_SettingsFile}" VerticalAlignment="Center" Margin="0,0,8,0" />
			<ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding SettingsProfiles}"
			          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberBinding="{Binding Name}" />
		</Grid>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,20,0,0">
			<Button Content="{loc:Loc String_Cancel}" Width="80" Click="OnCancel" />
			<Button Content="{loc:Loc String_OK}" Width="80" Click="OnOk" />
		</StackPanel>
	</StackPanel>
</Window>
