<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Chummer.NewUI.ViewModels" x:Class="Chummer.NewUI.Dialogs.LifestyleDialog" x:DataType="vm:LifestyleDialogViewModel" Title="Lebensstil auswählen" Width="560" Height="460" WindowStartupLocation="CenterOwner">
 <Grid Margin="12" RowDefinitions="Auto,*,Auto"><TextBox PlaceholderText="Suchen" Text="{Binding Search}"/><ListBox Grid.Row="1" Margin="0,8" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LifestyleOptionViewModel"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"><Button Content="Abbruch" Click="OnCancel"/><Button Content="Hinzufügen" Click="OnOk"/></StackPanel></Grid>
</Window>
