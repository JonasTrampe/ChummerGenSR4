<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sections="clr-namespace:Chummer.NewUI.Controls.CharacterSections"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chummer.NewUI.Controls.CharacterTab">
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderChromeBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="LayoutRoot" RowDefinitions="Auto,*">
                <Border x:Name="WorkbenchSummary" Grid.Row="0" IsVisible="False" Classes="workbenchSummary">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="1">
                            <TextBlock x:Name="WorkbenchCharacterName" FontWeight="SemiBold" />
                            <TextBlock x:Name="WorkbenchCharacterStatus" Classes="settingsHint" />
                        </StackPanel>
                        <Button x:Name="InspectorToggleButton" Grid.Column="1" Click="OnToggleInspectorClick" />
                    </Grid>
                </Border>

                <Grid x:Name="ContentLayout" Grid.Row="1" ColumnDefinitions="*,4,270">

                <TabControl x:Name="SectionTabs" Grid.Column="0">
                    <TabItem Header="{loc:Loc Tab_Common}">
                        <sections:GeneralSectionTab Name="GeneralTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc Tab_Skills}">
                        <sections:SkillsSectionTab Name="SkillsTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc Tab_MartialArts}">
                        <sections:MartialArtsSectionTab Name="MartialArtsTab" />
                    </TabItem>
                    <!-- Adeptenkräfte: conditional tab - Adept characters only -->
                    <TabItem x:Name="AdeptPowersTabItem" Header="{loc:Loc Tab_Adept}">
                        <sections:AdeptPowersSectionTab Name="AdeptPowersTab" />
                    </TabItem>
                    <!-- Sprüche und Geister: conditional tab - Magician/Adept characters -->
                    <TabItem x:Name="SpellsTabItem" Header="{loc:Loc Tab_Magician}">
                        <sections:SpellsSectionTab Name="SpellsTab" />
                    </TabItem>
                    <!-- Initiation: conditional tab - Awakened characters only -->
                    <TabItem x:Name="InitiationTabItem" Header="{loc:Loc Tab_Initiation}">
                        <sections:InitiationSectionTab Name="InitiationTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc Tab_Cyberware}">
                        <sections:CyberwareSectionTab Name="CyberwareTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc Tab_StreeGear}">
                        <sections:GearSectionTab Name="GearTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc Tab_Vehicles}">
                        <sections:VehiclesSectionTab Name="VehiclesTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc Tab_CharacterInfo}">
                        <sections:CharacterInfoSectionTab Name="CharacterInfoTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc Tab_Karma}">
                        <sections:KarmaNuyenSectionTab Name="KarmaNuyenTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc Tab_Calendar}">
                        <sections:CalendarTab x:Name="CalendarTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc Title_Notes}">
                        <sections:NotesTab x:Name="NotesTab" />
                    </TabItem>
                    <TabItem Header="{loc:Loc UI_Improve}">
                        <sections:ImprovementsTab x:Name="ImprovementsTab" />
                    </TabItem>
                </TabControl>

                <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Background="{DynamicResource BorderChromeBrush}" />

                <sections:CharacterSidebar Name="Sidebar" Grid.Column="2" />
                </Grid>
            </Grid>
        </Border>
</UserControl>
