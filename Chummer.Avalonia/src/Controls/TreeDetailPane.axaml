<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Chummer.NewUI.Controls.TreeDetailPane"
             x:Name="root">
    <!-- HeaderContent (the action toolbar) sits above TreeContent, sharing its column width -
         it's the tree's own header, not a page-wide toolbar. Callers wrap their buttons in a
         WrapPanel so a long action list wraps onto more lines within the column instead of
         overflowing into the detail pane next to it. -->
    <Grid Margin="{Binding ContentMargin, ElementName=root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding TreeWidth, ElementName=root, FallbackValue=260}" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentPresenter Grid.Row="0" Grid.Column="0" Content="{Binding HeaderContent, ElementName=root}" Margin="0,0,0,4" />
        <ContentPresenter Grid.Row="1" Grid.Column="0" Content="{Binding TreeContent, ElementName=root}" />
        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="#E4E4E4" />
        <ContentPresenter Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Content="{Binding DetailContent, ElementName=root}" />
    </Grid>
</UserControl>
