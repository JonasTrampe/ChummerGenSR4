<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
             xmlns:vm="clr-namespace:Chummer.NewUI.ViewModels"
             x:Class="Chummer.NewUI.Controls.CharacterSections.ImprovementsTab"
             x:DataType="vm:ImprovementsSectionViewModel">
    <controls:TreeDetailPane ContentMargin="8">
        <controls:TreeDetailPane.HeaderContent>
            <WrapPanel Margin="0,4,0,0">
                <Button Content="{loc:Loc Button_AddImproevment}" Click="OnAddImprovementClick"
                        ToolTip.Tip="{loc:Loc UI_ManualImprovementScopeTooltip}" Margin="0,0,4,4" />
            </WrapPanel>
        </controls:TreeDetailPane.HeaderContent>
        <controls:TreeDetailPane.TreeContent>
            <ListBox ItemsSource="{Binding Improvements}" SelectedItem="{Binding SelectedImprovement, Mode=TwoWay}" KeyDown="OnListKeyDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc Button_EditImprovement}" Click="OnEditImprovementClick"
                                  IsEnabled="{Binding SelectedImprovement.CanEdit}" />
                        <MenuItem Header="{loc:Loc String_Delete}" Click="OnDeleteImprovementClick"
                                  IsEnabled="{Binding SelectedImprovement.IsCustom}"
                                  ToolTip.Tip="{loc:Loc UI_OnlyManualImprovementsDeletableTooltip}" />
                        <MenuItem Header="{loc:Loc Button_AddGroup}" Click="OnAssignGroupClick"
                                  IsEnabled="{Binding SelectedImprovement.IsCustom}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImprovementRowViewModel">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </controls:TreeDetailPane.TreeContent>
        <controls:TreeDetailPane.DetailContent>
            <StackPanel Margin="8,0,0,0" Spacing="6">
                <controls:InfoRow Label="Typ:" Value="{Binding SelectedImprovement.Type}" />
                <controls:InfoRow Label="Ziel:" Value="{Binding SelectedImprovement.Target}" />
                <controls:InfoRow Label="Wert:" Value="{Binding SelectedImprovement.Value}" />
                <controls:InfoRow Label="Quelle:" Value="{Binding SelectedImprovement.Source}" />
                <controls:InfoRow Label="{loc:Loc Label_Group}" Value="{Binding SelectedImprovement.Group}" />
            </StackPanel>
        </controls:TreeDetailPane.DetailContent>
    </controls:TreeDetailPane>
</UserControl>
