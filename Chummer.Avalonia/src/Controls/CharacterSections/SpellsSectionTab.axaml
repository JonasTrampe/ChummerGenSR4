<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
             xmlns:vm="clr-namespace:Chummer.NewUI.ViewModels"
             x:Class="Chummer.NewUI.Controls.CharacterSections.SpellsSectionTab"
             x:DataType="vm:SpellsSectionViewModel">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
            <Button Content="Zauber hinzufügen" Click="OnAddSpellClick" />
            <Button Content="Löschen" Click="OnDeleteSpellClick" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6"
                    IsVisible="{Binding ShowTradition}">
            <TextBlock Text="Tradition:" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Traditions}" SelectedItem="{Binding SelectedTradition, Mode=TwoWay}" Width="180" />
            <TextBlock Text="{Binding DrainResistanceText}" IsVisible="{Binding ShowDrainResistance}" VerticalAlignment="Center" FontWeight="Bold" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6"
                    IsVisible="{Binding ShowStream}">
            <TextBlock Text="Stream:" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream, Mode=TwoWay}" Width="180" />
            <TextBlock Text="{Binding FadingResistanceText}" IsVisible="{Binding ShowFadingResistance}" VerticalAlignment="Center" FontWeight="Bold" />
        </StackPanel>
        <Grid ColumnDefinitions="220,4,*" RowDefinitions="*,Auto,Auto">
            <DockPanel Grid.Row="0" Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Ausgewählte Zauber" FontWeight="Bold" Margin="0,0,0,4" />
                <TreeView ItemsSource="{Binding SpellCategories}" SelectedItem="{Binding SelectedSpellNode, Mode=TwoWay}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Row="0" Grid.Column="1" Background="#E4E4E4" />

            <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Spacing="6">
            <controls:InfoRow Label="Kategorie:" Value="{Binding SelectedSpellNode.Category, TargetNullValue=–}" />
            <Grid ColumnDefinitions="*,*,*">
                <TextBlock Grid.Column="0" Text="{Binding SelectedSpellNode.SpellType, StringFormat='Typ: {0}'}" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedSpellNode.SpellRange, StringFormat='Reichweite: {0}'}" />
                <TextBlock Grid.Column="2" Text="{Binding SelectedSpellNode.SpellDamage, StringFormat='Schaden: {0}'}" />
            </Grid>
            <Grid ColumnDefinitions="*,*">
                <TextBlock Grid.Column="0" Text="{Binding SelectedSpellNode.SpellDuration, StringFormat='Dauer: {0}'}" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedSpellNode.SpellDv, StringFormat='Entzugsformel: {0}'}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Quelle:" FontWeight="Bold" />
                <controls:SourceLink SourcePage="{Binding SelectedSpellNode.SourcePage}" />
            </StackPanel>
        </StackPanel>

        <!-- Geister section spans the full tab width, below the spell tree/detail split -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#E4E4E4"
                BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0">
            <StackPanel>
                <TextBlock Text="Geister" FontWeight="Bold" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,0,6">
                    <Button Content="Geist" Click="OnAddSpiritClick" />
                    <Button Content="Löschen" Click="OnDeleteSpiritClick" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Spirits}" SelectedItem="{Binding SelectedSpirit, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpiritRowViewModel">
                            <controls:InfoRow Label="{Binding Label}" Value="{Binding Value}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Complex Forms / Critter Powers - both support add/delete via a picker. -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#E4E4E4"
                BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0">
            <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Komplexe Formen" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,0,6">
                        <Button Content="Programm" Click="OnAddComplexFormClick" />
                        <Button Content="Löschen" Click="OnDeleteComplexFormClick" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ComplexForms}" SelectedItem="{Binding SelectedComplexForm, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComplexFormRowViewModel">
                                <controls:InfoRow Label="{Binding Label}" Value="{Binding Value}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Kritter-Kräfte" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding FreeSpiritPowerPointsText}" IsVisible="{Binding ShowFreeSpiritPowerPoints}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,0,6">
                        <Button Content="Kraft" Click="OnAddCritterPowerClick" />
                        <Button Content="Löschen" Click="OnDeleteCritterPowerClick" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding CritterPowers}" SelectedItem="{Binding SelectedCritterPower, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CritterPowerRowViewModel">
                                <controls:InfoRow Label="{Binding Label}" Value="{Binding Value}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
</UserControl>
