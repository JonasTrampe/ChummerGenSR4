<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
             xmlns:vm="clr-namespace:Chummer.NewUI.ViewModels"
             x:Class="Chummer.NewUI.Controls.CharacterSections.MartialArtsSectionTab"
             x:DataType="vm:MartialArtsSectionViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="#888888" />
        </Style>
    </UserControl.Styles>
    <controls:TreeDetailPane ContentMargin="2 8 2 4">
        <controls:TreeDetailPane.HeaderContent>
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
                <Button Content="{loc:Loc UI_AddMartialArt}" Click="OnAddMartialArtClick" />
                <Button Content="{loc:Loc UI_AddManeuver}" Click="OnAddManeuverClick" />
                <Button Content="{loc:Loc Tab_Notes}" Click="OnEditNotesClick" />
                <Button Content="{loc:Loc String_Delete}" Click="OnDeleteClick" />
            </StackPanel>
        </controls:TreeDetailPane.HeaderContent>
        <controls:TreeDetailPane.TreeContent>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MartialArtsListItemViewModel">
                        <TextBlock Text="{Binding Text}" Classes.header="{Binding IsHeader}"
                                   Margin="{Binding IndentLeft, StringFormat='{}{0},0,0,0'}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </controls:TreeDetailPane.TreeContent>
        <controls:TreeDetailPane.DetailContent>
            <StackPanel Margin="12,0,0,0" Spacing="6">
                <Grid ColumnDefinitions="Auto,Auto">
                    <TextBlock Text="{loc:Loc Label_Rating}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Classes="iconButton">
                        <Image Source="avares://Chummer.Avalonia/assets/icons/add.png" />
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{loc:Loc Label_Source}" />
                    <controls:SourceLink SourcePage="{Binding SelectedItem.SourcePage}" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedItem.Notes, StringFormat='Notizen: {0}'}" TextWrapping="Wrap" />
            </StackPanel>
        </controls:TreeDetailPane.DetailContent>
    </controls:TreeDetailPane>
</UserControl>
