<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
             xmlns:vm="clr-namespace:Chummer.NewUI.ViewModels"
             x:Class="Chummer.NewUI.Controls.CharacterSections.VehiclesSectionTab"
             x:DataType="vm:VehiclesSectionViewModel">
    <controls:TreeDetailPane TreeWidth="300" ContentMargin="4">
        <controls:TreeDetailPane.HeaderContent>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Spacing="2">
                <Button Content="{loc:Loc UI_AddVehicle}" Click="OnAddVehicleClick" />
                <Button Content="{loc:Loc Menu_AddModification}" Click="OnAddVehicleModClick" />
                <Button Content="{loc:Loc UI_AddVehicleGear}" Click="OnAddVehicleGearClick" />
                <Button Content="{loc:Loc UI_AddVehicleWeapon}" Click="OnAddVehicleWeaponClick"
                        ToolTip.Tip="{loc:Loc UI_VehicleWeaponMountTooltip}" />
                <Button Content="{loc:Loc Button_AddLocation}" Click="OnAddVehicleLocationClick" />
                <Button Content="{loc:Loc UI_DeleteLocation}" Click="OnRemoveVehicleLocationClick" />
                <Button Content="{loc:Loc String_Delete}" Click="OnDeleteVehicleClick" />
                <Button Content="{loc:Loc UI_Sell}" Click="OnSellVehicleClick" />
                <Button Content="{loc:Loc Button_Reload}" Click="OnReloadVehicleWeaponClick" />
            </StackPanel>
        </controls:TreeDetailPane.HeaderContent>
        <controls:TreeDetailPane.TreeContent>
            <TreeView ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </controls:TreeDetailPane.TreeContent>
        <controls:TreeDetailPane.DetailContent>
            <ScrollViewer>
                <StackPanel Margin="8,0,0,0" Spacing="6">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{loc:Loc Label_Name}" Width="70" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedVehicle.Name}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{loc:Loc Label_Category}" Width="70" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedVehicle.Category}" />
                    </Grid>
                    <Separator Margin="0,2" />
                    <Grid ColumnDefinitions="*,*,*,*">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedVehicle.Handling, StringFormat='Handling: {0}'}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedVehicle.Acceleration, StringFormat='Beschleunigung: {0}'}" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedVehicle.Speed, StringFormat='Geschwindigkeit: {0}'}" />
                        <TextBlock Grid.Column="3" Text="{Binding SelectedVehicle.DeviceRating, StringFormat='Gerät: {0}'}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedVehicle.Pilot, StringFormat='Pilot: {0}'}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedVehicle.Body, StringFormat='Rumpf: {0}'}" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedVehicle.VehicleArmor, StringFormat='Panzerung: {0}'}" />
                        <TextBlock Grid.Column="3" Text="{Binding SelectedVehicle.Sensor, StringFormat='Sensor: {0}'}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Loc Label_Source}" />
                            <controls:SourceLink SourcePage="{Binding SelectedVehicle.SourcePage}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SelectedVehicle.PhysicalCmFilled, StringFormat='Schaden: {0}'}" Margin="16,0,0,0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="{loc:Loc UI_Repair}" Click="OnRepairVehicleClick" />
                        <Button Content="{loc:Loc UI_DamagePlus1}" Click="OnDamageVehicleClick" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{loc:Loc UI_LocationsColon}" Width="70" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SelectedVehicle.VehicleLocations}"
                                  SelectedItem="{Binding SelectedVehicleLocation, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{loc:Loc UI_GearLocationColon}" Width="130" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedVehicle.Location, TargetNullValue=(keiner)}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{loc:Loc UI_Assign}" Click="OnAssignVehicleGearLocationClick"
                                ToolTip.Tip="{loc:Loc UI_AssignVehicleGearLocationTooltip}" />
                    </Grid>
                    <Separator Margin="0,2" />
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedVehicle.Avail, StringFormat='Verfügbarkeit: {0}'}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedVehicle.Cost, StringFormat='Grundkosten: {0}¥'}"
                                   ToolTip.Tip="{loc:Loc UI_VehicleBaseCostTooltip}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedVehicle.TotalCost, StringFormat='Gesamtkosten: {0}¥'}"
                                   ToolTip.Tip="{loc:Loc UI_VehicleTotalCostTooltip}" />
                        <TextBlock Grid.Column="1">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Slots: {0}/{1} ({2} frei)">
                                    <Binding Path="SelectedVehicle.SlotsUsed" />
                                    <Binding Path="SelectedVehicle.TotalSlots" />
                                    <Binding Path="SelectedVehicle.SlotsRemaining" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </controls:TreeDetailPane.DetailContent>
    </controls:TreeDetailPane>
</UserControl>
