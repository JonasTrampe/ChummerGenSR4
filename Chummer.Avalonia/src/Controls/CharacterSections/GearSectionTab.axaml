<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
             xmlns:core="using:Chummer.Core"
             xmlns:vm="clr-namespace:Chummer.NewUI.ViewModels"
             x:Class="Chummer.NewUI.Controls.CharacterSections.GearSectionTab"
             x:DataType="vm:GearSectionViewModel">
    <TabControl Margin="4">
        <TabItem Header="{loc:Loc Tab_Lifestyle}">
            <Grid ColumnDefinitions="200,4,*" Margin="4">
                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
                        <Button Content="{loc:Loc Button_AddLifestyle}" Click="OnAddLifestyleClick" />
                        <Button Content="{loc:Loc UI_CreateAdvancedLifestyle}" Click="OnAddAdvancedLifestyleClick" />
                        <Button Content="{loc:Loc String_Delete}" Click="OnDeleteLifestyleClick" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Lifestyles}" SelectedItem="{Binding SelectedLifestyle, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LifestyleRowViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <GridSplitter Grid.Column="1" Background="#E4E4E4" />
                <StackPanel Grid.Column="2" Margin="8,0,0,0" Spacing="4">
                    <TextBlock Text="{Binding LifestyleCost}" />
                    <TextBlock
                        Text="{loc:Loc UI_LifestyleQualitiesHeader}"
                        Foreground="#666666" FontStyle="Italic" />
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="{loc:Loc Tab_Armor}">
            <controls:TreeDetailPane TreeWidth="220" ContentMargin="4">
                <controls:TreeDetailPane.HeaderContent>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Spacing="2">
                        <Button Content="{loc:Loc UI_AddArmor}" Click="OnAddArmorClick" />
                        <Button Content="{loc:Loc String_Delete}" Click="OnDeleteArmorClick" />
                        <Button Content="{loc:Loc UI_Sell}" Click="OnSellArmorClick" />
                        <Button Content="{loc:Loc UI_AddMod}" Click="OnAddArmorModClick" />
                        <Button Content="{loc:Loc UI_DeleteMod}" Click="OnDeleteArmorModClick" />
                        <Button Content="B−" Click="OnArmorBallisticDamageClick" IsVisible="{Binding ArmorDegradationEnabled}" />
                        <Button Content="B+" Click="OnArmorBallisticRepairClick" IsVisible="{Binding ArmorDegradationEnabled}" />
                        <Button Content="I−" Click="OnArmorImpactDamageClick" IsVisible="{Binding ArmorDegradationEnabled}" />
                        <Button Content="I+" Click="OnArmorImpactRepairClick" IsVisible="{Binding ArmorDegradationEnabled}" />
                        <Button Content="{loc:Loc Button_AddBundle}" Click="OnAddArmorSetClick" />
                        <ComboBox ItemsSource="{Binding ArmorCategories}"
                                  SelectedItem="{Binding SelectedArmorCategory, Mode=TwoWay}"
                                  Margin="6,0,0,0" />
                    </StackPanel>
                </controls:TreeDetailPane.HeaderContent>
                <controls:TreeDetailPane.TreeContent>
                    <TreeView Name="ArmorTree" ItemsSource="{Binding Armor}" SelectedItem="{Binding SelectedArmor, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </controls:TreeDetailPane.TreeContent>
                <controls:TreeDetailPane.DetailContent>
                    <StackPanel Margin="8,0,0,0" Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                        <TextBlock Grid.Row="0" Text="{loc:Loc Label_Name}" Width="90" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedArmor.Name, TargetNullValue=–}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="{loc:Loc Label_Category}" Width="90" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedArmor.Category, TargetNullValue=–}" />
                        <TextBlock Grid.Row="2" Text="{loc:Loc UI_BallisticImpactColon}" Width="90" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding SelectedArmor.Ballistic, TargetNullValue=–}" />
                            <TextBlock Text="/" />
                            <TextBlock Text="{Binding SelectedArmor.Impact, TargetNullValue=–}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="{loc:Loc UI_CreatedColon}" Width="90" />
                        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding SelectedArmor.Equipped}"
                                  Click="OnToggleArmorEquippedClick" />
                        <TextBlock Grid.Row="4" Text="{loc:Loc Label_Capacity}" Width="90"
                                   IsVisible="{Binding SelectedArmor.HasCapacity}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedArmor.CapacityDisplay, TargetNullValue=–}"
                                   IsVisible="{Binding SelectedArmor.HasCapacity}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{loc:Loc UI_CostAvailColon}" Width="90" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding SelectedArmor.Cost, TargetNullValue=–}" />
                            <TextBlock Text="¥ /" />
                            <TextBlock Text="{Binding SelectedArmor.Avail, TargetNullValue=–}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{loc:Loc UI_SetColon}" Width="90" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ArmorSets}"
                                  SelectedItem="{Binding SelectedArmorSet, Mode=TwoWay}" />
                    </Grid>
                    <Button Content="{loc:Loc UI_DisbandSet}" HorizontalAlignment="Left"
                            IsVisible="{Binding IsArmorSetSelected}" Click="OnRemoveArmorSetClick" />
                    <Separator Margin="0,4" />
                    <TextBlock Text="{Binding ArmorRating}" FontWeight="Bold" />
                    <TextBlock Text="{Binding ArmorEncumbrance}" Foreground="#666666" />
                    </StackPanel>
                </controls:TreeDetailPane.DetailContent>
            </controls:TreeDetailPane>
        </TabItem>

        <TabItem Header="{loc:Loc Tab_Weapons}">
            <controls:TreeDetailPane TreeWidth="80" ContentMargin="4">
                <controls:TreeDetailPane.HeaderContent>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Spacing="2">
                        <Button Content="{loc:Loc Menu_AddWeapon}" Click="OnAddWeaponClick" />
                        <Button Content="{loc:Loc Menu_AddNaturalWeapon}" Click="OnAddNaturalWeaponClick" />
                        <Button Content="{loc:Loc UI_AddAccessory}" Click="OnAddWeaponAccessoryClick" />
                        <Button Content="{loc:Loc UI_AddMod}" Click="OnAddWeaponModClick" />
                        <Button Content="{loc:Loc String_Delete}" Click="OnDeleteWeaponClick" />
                        <Button Content="{loc:Loc UI_Sell}" Click="OnSellWeaponClick" />
                        <Button Content="{loc:Loc Button_Reload}" Click="OnReloadWeaponClick" />
                        <Button Content="{loc:Loc Button_AddLocation}" Click="OnAddWeaponLocationClick" />
                    </StackPanel>
                </controls:TreeDetailPane.HeaderContent>
                <controls:TreeDetailPane.TreeContent>
                    <TreeView Name="WeaponsTree" ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedWeapon, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </controls:TreeDetailPane.TreeContent>
                <controls:TreeDetailPane.DetailContent>
                    <ScrollViewer>
                        <StackPanel Margin="8,0,0,0" Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Text="{loc:Loc Label_Name}" Width="90" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedWeapon.Name, TargetNullValue=–}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="{loc:Loc Label_Category}" Width="90" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedWeapon.Category, TargetNullValue=–}" />
                            <TextBlock Grid.Row="2" Text="{loc:Loc Label_Rating}" Width="90" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedWeapon.Rating, TargetNullValue=–}" />
                            <TextBlock Grid.Row="3" Text="{loc:Loc UI_InstalledColon}" Width="90" />
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding SelectedWeapon.Equipped}" Click="OnToggleWeaponEquippedClick" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc UI_CostAvailColon}" Width="90" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding SelectedWeapon.Cost, TargetNullValue=–}" />
                                <TextBlock Text="¥ /" />
                                <TextBlock Text="{Binding SelectedWeapon.Avail, TargetNullValue=–}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc Label_DicePool}" Width="90" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedWeapon.WeaponDicePool, TargetNullValue=–}"
                                       ToolTip.Tip="{Binding SelectedWeapon.WeaponDicePoolTooltip}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc UI_RecoilCompensationColon}" Width="90" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedWeapon.WeaponRc, TargetNullValue=–}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc UI_AmmoColon}" Width="90" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedWeapon.AmmoStatus, TargetNullValue=Nicht geladen, FallbackValue=Nicht geladen}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc UI_LocationColon}" Width="90" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding WeaponLocations}"
                                      SelectedItem="{Binding SelectedWeaponLocation, Mode=TwoWay}" />
                        </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </controls:TreeDetailPane.DetailContent>
            </controls:TreeDetailPane>
        </TabItem>

        <TabItem Header="{loc:Loc Tab_Gear}">
            <controls:TreeDetailPane TreeWidth="80" ContentMargin="4">
                <controls:TreeDetailPane.HeaderContent>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Spacing="2">
                        <Button Content="{loc:Loc Button_AddGear}" Click="OnAddGearClick" />
                        <Button Content="{loc:Loc UI_AssembleNexus}" Click="OnAddNexusClick" />
                        <Button Content="{loc:Loc UI_AddAsAccessory}" Click="OnAddChildGearClick" />
                        <Button Content="{loc:Loc String_Delete}" Click="OnDeleteGearClick" />
                        <Button Content="{loc:Loc UI_Sell}" Click="OnSellGearClick" />
                        <Button Content="{loc:Loc Button_AddLocation}" Click="OnAddGearLocationClick" />
                        <Button Content="{loc:Loc UI_DeleteLocation}" Click="OnRemoveGearLocationClick" />
                        <CheckBox Content="{loc:Loc Checkbox_Commlinks}" Margin="6,0,0,0" IsChecked="{Binding ShowOnlyCommlinks, Mode=TwoWay}" />
                    </StackPanel>
                </controls:TreeDetailPane.HeaderContent>
                <controls:TreeDetailPane.TreeContent>
                    <!-- Drag-and-drop reordering wired up in code-behind (SetUpGearDragDrop) -
                         matches the real app's gear/cyberware reordering in frmCareer/frmCreate,
                         one of the risk areas flagged in the Linux port plan's Avalonia audit. -->
                    <TreeView Name="AusruestungTree" ItemsSource="{Binding Gear}" SelectedItem="{Binding SelectedGear, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </controls:TreeDetailPane.TreeContent>
                <controls:TreeDetailPane.DetailContent>
                    <StackPanel Margin="8,0,0,0" Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc Label_Name}" Width="90" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedGear.TranslatedName, TargetNullValue=–}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc Label_Category}" Width="90" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedGear.Category, TargetNullValue=–}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="{loc:Loc Label_Rating}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedGear.Rating, TargetNullValue=–}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="{loc:Loc Label_Qty}" Width="90" />
                            <controls:IntegerSpinner Grid.Column="1" Width="90" HorizontalAlignment="Left" Minimum="1" Maximum="9999"
                                                      Value="{Binding SelectedGearQuantity, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc UI_InstalledColon}" Width="90" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding SelectedGear.Equipped}"
                                      Click="OnToggleGearEquippedClick" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc Label_Capacity}" Width="90" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedGear.CapacityDisplay, TargetNullValue=–}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{loc:Loc UI_CostAvailColon}" Width="90" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding SelectedGear.Cost, TargetNullValue=–}" />
                                <TextBlock Text="¥ /" />
                                <TextBlock Text="{Binding SelectedGear.Avail, TargetNullValue=–}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsGearLocationSelected}">
                            <TextBlock Text="{loc:Loc UI_LocationColon}" Width="90" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding GearLocations}"
                                      SelectedItem="{Binding SelectedGearLocation, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding SelectedGear.HasCommlinkStats}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc Label_SelectNexus_Processor}" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedGear.EffectiveResponse, TargetNullValue=–}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc Label_Signal}" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedGear.EffectiveSignal, TargetNullValue=–}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc Label_System}" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedGear.EffectiveSystem, TargetNullValue=–}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc Label_Firewall}" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedGear.EffectiveFirewall, TargetNullValue=–}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </controls:TreeDetailPane.DetailContent>
            </controls:TreeDetailPane>
        </TabItem>

        <TabItem Header="{loc:Loc Tab_Pets}">
            <StackPanel Margin="8" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="{loc:Loc Button_AddPet}" Click="OnAddPetClick" />
                    <Button Content="{loc:Loc UI_LinkCharacter}" Click="OnLinkPetClick" />
                    <Button Content="{loc:Loc MenuItem_OpenCharacter}" Click="OnOpenLinkedPetCharacterClick"
                            IsEnabled="{Binding SelectedPet.HasLinkedCharacter}" />
                    <Button Content="{loc:Loc UI_RemoveLink}" Click="OnUnlinkPetClick"
                            IsEnabled="{Binding SelectedPet.HasLinkedCharacter}" />
                    <Button Content="{loc:Loc String_Delete}" Click="OnDeletePetClick" />
                </StackPanel>
                <TextBlock Text="{loc:Loc UI_PetsLoadedFromContactsTooltip}" Foreground="#666666" />
                <TextBlock Text="{Binding SelectedPet.FileName, TargetNullValue='Kein Begleiter-Charakter verknüpft'}"
                           Foreground="#666666" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedPet.LinkedMetatype, StringFormat='Metatyp: {0}'}"
                           IsVisible="{Binding SelectedPet.HasLinkedCharacter}" />
                <ListBox ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedPet, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContactRowViewModel">
                            <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="8" Margin="0,2">
                                <TextBox Text="{Binding Name, Mode=TwoWay}" FontWeight="SemiBold" />
                                <TextBox Grid.Column="1" Text="{Binding Notes, Mode=TwoWay}" PlaceholderText="{loc:Loc Tab_Notes}" />
                                <TextBlock Grid.Column="2" Text="{Binding Free, StringFormat='Kostenlos: {0}'}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </TabItem>
    </TabControl>
</UserControl>
