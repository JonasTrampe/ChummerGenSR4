<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
             xmlns:vm="clr-namespace:Chummer.NewUI.ViewModels"
             x:Class="Chummer.NewUI.Controls.CharacterSections.AdeptPowersSectionTab"
             x:DataType="vm:AdeptPowersSectionViewModel">
    <DockPanel Margin="2 8 2 4">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <Button Content="{loc:Loc String_Force}" Click="OnAddPowerClick" />
            <TextBlock Text="{Binding PowerPointsText}" FontWeight="Bold"
                       VerticalAlignment="Center" ToolTip.Tip="{Binding PowerPointsTooltip}" />

        </StackPanel>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Powers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AdeptPowerRowViewModel">
                        <controls:AdeptPowerRow PowerName="{Binding PowerName}"
                                                PowerLevel="{Binding PowerLevel}"
                                                PricePerLevel="{Binding PricePerLevel}"
                                                TotalCost="{Binding TotalCost}"
                                                IsWayOfTheAdept="{Binding IsWayOfTheAdept}"
                                                IsMagicFocus="{Binding IsMagicFocus}"
                                                IsNudEnabled="{Binding IsNudEnabled}"
                                                DeleteClicked="OnDeletePowerClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
