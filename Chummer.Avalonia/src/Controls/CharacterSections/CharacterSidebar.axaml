<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chummer.NewUI.Controls"
             xmlns:vm="clr-namespace:Chummer.NewUI.ViewModels"
             x:Class="Chummer.NewUI.Controls.CharacterSections.CharacterSidebar"
             x:DataType="vm:CharacterSidebarViewModel">
    <!-- Right sidebar is itself a 2-tab control (Weitere Informationen / Zustandsmonitor),
	     stays visible outside the main TabControl (splitMain in the real designer file). -->
    <TabControl Classes="sidebar">
        <TabItem Header="Weitere Informationen">
            <ScrollViewer>
                <StackPanel Margin="6" Spacing="4">
                    <controls:InfoRow Label="Körperlicher Zustandsmonitor:" Value="{Binding PhysicalMonitor.Value}"
                                       Tooltip="{Binding PhysicalMonitor.Tooltip}" />
                    <controls:InfoRow Label="Geistiger Zustandsmonitor:" Value="{Binding StunMonitor.Value}"
                                       Tooltip="{Binding StunMonitor.Tooltip}" />
                    <controls:InfoRow Label="Initiative:" Value="{Binding Initiative.Value}"
                                       Tooltip="{Binding Initiative.Tooltip}" />
                    <controls:InfoRow Label="Initiativedurchgänge:" Value="{Binding InitiativePasses.Value}"
                                       Tooltip="{Binding InitiativePasses.Tooltip}" />
                    <TextBlock Text="Aktiver Kommlink:" Margin="0,4,0,0" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Commlinks}"
                              SelectedItem="{Binding SelectedCommlink}"
                              DisplayMemberBinding="{Binding DisplayName}" />
                    <controls:InfoRow Label="Matrixinitiative:" Value="{Binding MatrixInitiative.Value}"
                                       Tooltip="{Binding MatrixInitiative.Tooltip}" />
                    <controls:InfoRow Label="Matrixinitiativedurchgänge:" Value="{Binding MatrixInitiativePasses.Value}"
                                       Tooltip="{Binding MatrixInitiativePasses.Tooltip}" />
                    <controls:InfoRow Label="Astrale Initiative:" Value="{Binding AstralInitiative.Value}"
                                       Tooltip="{Binding AstralInitiative.Tooltip}" />
                    <controls:InfoRow Label="Ballistische Panzerung:" Value="{Binding BallisticArmor.Value}"
                                      Tooltip="{Binding BallisticArmor.Tooltip}" />
                    <controls:InfoRow Label="Stoßpanzerung:" Value="{Binding ImpactArmor.Value}"
                                      Tooltip="{Binding ImpactArmor.Tooltip}" />
                    <controls:InfoRow Label="Rüstungsbehinderung (ballistisch):" Value="{Binding BallisticEncumbrance.Value}"
                                       Tooltip="{Binding BallisticEncumbrance.Tooltip}" />
                    <controls:InfoRow Label="Rüstungsbehinderung (Stoß):" Value="{Binding ImpactEncumbrance.Value}"
                                       Tooltip="{Binding ImpactEncumbrance.Tooltip}" />
                    <controls:InfoRow Label="Essenz:" Value="{Binding Essence}" />
                    <controls:InfoRow Label="Verbleibende Nuyen:" Value="{Binding RemainingNuyen}" />
                    <controls:InfoRow Label="Karma der gesamten Laufbahn:" Value="{Binding CareerKarma}" />
                    <controls:InfoRow Label="Karriere Nuyen:" Value="{Binding CareerNuyen}" />
                    <controls:InfoRow Label="Selbstbeherrschung:" Value="{Binding Composure.Value}"
                                       Tooltip="{Binding Composure.Tooltip}" />
                    <controls:InfoRow Label="Menschenkenntnis:" Value="{Binding JudgeIntentions.Value}"
                                       Tooltip="{Binding JudgeIntentions.Tooltip}" />
                    <controls:InfoRow Label="Heben und Tragen:" Value="{Binding LiftAndCarry.Value}"
                                       Tooltip="{Binding LiftAndCarry.Tooltip}" />
                    <controls:InfoRow Label="Gedächtnis:" Value="{Binding Memory.Value}"
                                       Tooltip="{Binding Memory.Tooltip}" />
                    <controls:InfoRow Label="Bewegung:" Value="{Binding WalkMovement}" />
                    <controls:InfoRow Label="Schwimmen:" Value="{Binding SwimMovement}" />
                    <controls:InfoRow Label="Fliegen:" Value="{Binding FlyMovement}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Zustandsmonitor">
            <ScrollViewer>
                <StackPanel Margin="6" Spacing="4">
                    <controls:InfoRow Label="Körperlicher Schaden:" Value="{Binding PhysicalDamage}" />
                    <controls:InfoRow Label="Geistiger Schaden:" Value="{Binding StunDamage}" />
                    <controls:InfoRow Label="Verletzungsmodifikator:" Value="{Binding WoundModifiers}" />
        <controls:InfoRow Label="Ballistische Panzerung:" Value="{Binding BallisticArmor.Value}"
                          Tooltip="{Binding BallisticArmor.Tooltip}" />
        <controls:InfoRow Label="Stoßpanzerung:" Value="{Binding ImpactArmor.Value}"
                          Tooltip="{Binding ImpactArmor.Tooltip}" />
                    <controls:InfoRow Label="Schadenswiderstandswürfelpool:" Value="{Binding DamageResistance.Value}"
                                      Tooltip="{Binding DamageResistance.Tooltip}" />

                    <TextBlock Text="Physisch" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding PhysicalMonitorBoxes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="22" ItemHeight="22" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConditionMonitorBoxViewModel">
                                <Border Classes="cmBox" Background="{Binding Background}" ToolTip.Tip="{Binding Tooltip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Heilen" Click="OnHealPhysicalDamageClick" />
                        <Button Content="Schaden +1" Click="OnAddPhysicalDamageClick" />
                    </StackPanel>

                    <TextBlock Text="Geistig" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding StunMonitorBoxes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="22" ItemHeight="22" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConditionMonitorBoxViewModel">
                                <Border Classes="cmBox" Background="{Binding Background}" ToolTip.Tip="{Binding Tooltip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Heilen" Click="OnHealStunDamageClick" />
                        <Button Content="Schaden +1" Click="OnAddStunDamageClick" />
                    </StackPanel>

                    <TextBlock Text="Zurück erhalten/Ausgeben von Edge" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Edge}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="iconButton" Click="OnRegainEdgeClick">
                            <Image Source="avares://Chummer.Avalonia/assets/icons/add.png" />
                        </Button>
                        <Button Classes="iconButton" Click="OnSpendEdgeClick">
                            <Image Source="avares://Chummer.Avalonia/assets/icons/delete.png" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
