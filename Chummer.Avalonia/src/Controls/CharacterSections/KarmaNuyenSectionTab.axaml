<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="clr-namespace:Chummer.NewUI.Markup"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chummer.NewUI.ViewModels"
             x:Class="Chummer.NewUI.Controls.CharacterSections.KarmaNuyenSectionTab"
             x:DataType="vm:KarmaNuyenSectionViewModel">
    <Grid RowDefinitions="*,188" Margin="4">
        <Grid Grid.Row="0" ColumnDefinitions="*,*">
            <Grid Grid.Column="0" Margin="0,0,4,0" RowDefinitions="Auto,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
                    <Button Content="{loc:Loc Button_KarmaGained}" Click="OnKarmaEarnedClick" />
                    <Button Content="{loc:Loc Button_KarmaSpent}" Click="OnKarmaSpentClick" />
                    <Button Content="{loc:Loc Button_EditExpense}" Click="OnEditKarmaExpenseClick" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="80,50,*" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Classes="gridHeader" Text="{loc:Loc String_Date}" />
                    <TextBlock Grid.Column="1" Classes="gridHeader" Text="{loc:Loc String_Amount}" />
                    <TextBlock Grid.Column="2" Classes="gridHeader" Text="{loc:Loc String_Reason}" />
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding KarmaExpenses}"
                         SelectedItem="{Binding SelectedKarmaExpense, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExpenseRowViewModel">
                            <Grid ColumnDefinitions="80,50,*">
                                <TextBlock Grid.Column="0" Text="{Binding Date}" />
                                <TextBlock Grid.Column="1" Text="{Binding Amount}" />
                                <TextBlock Grid.Column="2" Text="{Binding Reason}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid Grid.Column="1" Margin="4,0,0,0" RowDefinitions="Auto,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
                    <Button Content="{loc:Loc Button_NuyenGained}" Click="OnNuyenEarnedClick" />
                    <Button Content="{loc:Loc Button_NuyenSpent}" Click="OnNuyenSpentClick" />
                    <Button Content="{loc:Loc Button_EditExpense}" Click="OnEditNuyenExpenseClick" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="80,60,*" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Classes="gridHeader" Text="{loc:Loc String_Date}" />
                    <TextBlock Grid.Column="1" Classes="gridHeader" Text="{loc:Loc String_Amount}" />
                    <TextBlock Grid.Column="2" Classes="gridHeader" Text="{loc:Loc String_Reason}" />
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding NuyenExpenses}"
                         SelectedItem="{Binding SelectedNuyenExpense, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExpenseRowViewModel">
                            <Grid ColumnDefinitions="80,60,*">
                                <TextBlock Grid.Column="0" Text="{Binding Date}" />
                                <TextBlock Grid.Column="1" Text="{Binding Amount}" />
                                <TextBlock Grid.Column="2" Text="{Binding Reason}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Real ScottPlot.Avalonia charts (the actual replacement for the WinForms
             System.Windows.Forms.DataVisualization area charts, per the Linux port plan's
             Phase 2 chart decision). Follows ScottPlot's own MVVM pattern
             (https://scottplot.net/quickstart/wpf/): the ViewModel owns the AvaPlot instance and
             this just hosts it, instead of naming the control here and reaching into it from
             code-behind. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,8,0,0">
            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" Margin="0,0,4,0"
                    Height="180">
                <ContentControl Content="{Binding KarmaChart, Mode=OneTime}" />
            </Border>
            <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" Margin="4,0,0,0"
                    Height="180">
                <ContentControl Content="{Binding NuyenChart, Mode=OneTime}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
