<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>RunnersPoint.Api</PackageId>
    <Description>Reusable .NET client and authentication support for the RunnersPoint document API.</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- The legacy WinForms host supplies its own Mono-compatible transport and credential store. -->
    <Compile Remove="src/RunnersPointApiClient.cs" />
    <Compile Remove="src/RunnersPointAuth.cs" />
  </ItemGroup>
</Project>
